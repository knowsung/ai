/**
 * 구글 시트에서 네이버 데이터랩 쇼핑 인사이트 API를 활용해
 * 키워드별 검색 트렌드를 조회하는 앱스 스크립트입니다.
 */

// 사용자 지정 메뉴 생성
function onOpen() {
  var ui = SpreadsheetApp.getUi();
  ui.createMenu('네이버 데이터랩')
    .addItem('API 설정', 'showApiDialog')
    .addToUi();

  // 이미 인증 정보가 있다면 키워드 입력 시트를 보장합니다.
  var props = PropertiesService.getScriptProperties();
  if (props.getProperty('CLIENT_ID') && props.getProperty('CLIENT_SECRET')) {
    ensureKeywordInputSheet();
  }
}


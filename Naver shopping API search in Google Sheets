// API 인증 정보 저장
function saveApiCredentials(clientId, clientSecret) {
  var props = PropertiesService.getScriptProperties();
  props.setProperty('CLIENT_ID', clientId);
  props.setProperty('CLIENT_SECRET', clientSecret);

  ensureKeywordInputSheet();
  return 'API 인증 정보가 저장되었습니다. 시트1에서 키워드를 입력해보세요!';
}

// 시트1에 키워드 입력 영역 생성
function ensureKeywordInputSheet() {
  var ss = SpreadsheetApp.getActive();
  var sheet = ss.getSheetByName('시트1');
  if (!sheet) {
    sheet = ss.getSheets()[0];
    sheet.setName('시트1');
  }

  sheet.clear();
  sheet.getRange('A1').setValue('네이버 쇼핑 검색 트렌드 키워드 입력')
    .setFontWeight('bold')
    .setFontSize(14);

  sheet.getRange('A3').setValue('키워드');
  sheet.getRange('B3').setValue('');
  sheet.getRange('B3').setNote('검색할 키워드를 입력하면 "검색 트렌드" 시트가 자동으로 생성됩니다.');

  sheet.getRange('A1:B3').setHorizontalAlignment('left');
  sheet.getRange('A3:B3').setFontWeight('bold');
  sheet.setColumnWidths(1, 2, 200);
  sheet.setRowHeights(1, 3, 30);
}

// 키워드 입력시 자동으로 검색 트렌드 시트를 생성
function onEdit(e) {
  if (!e || !e.range) {
    return;
  }

  var range = e.range;
  var sheet = range.getSheet();

  if (sheet.getName() === '시트1' && range.getA1Notation() === 'B3') {
    var keyword = (range.getValue() || '').toString().trim();
    if (!keyword) {
      return;
    }

    try {
      buildTrendSheet(keyword);
    } catch (error) {
      SpreadsheetApp.getUi().alert('검색 트렌드를 생성하지 못했습니다.\n' + error.message);
    }
  }
}

// 검색 트렌드 시트 생성 및 데이터 채우기
function buildTrendSheet(keyword) {
  var credentials = getApiCredentials_();
  var ss = SpreadsheetApp.getActive();

  // 기존 시트가 있으면 제거 후 새로 생성
  var existing = ss.getSheetByName('검색 트렌드');
  if (existing) {
    ss.deleteSheet(existing);
  }
  var sheet = ss.insertSheet('검색 트렌드');

  var headers = ['키워드', '전체', '여성', '남성', '10대', '20대', '30대', '40대', '50대', '60대 이상'];
  sheet.getRange(1, 1, 1, headers.length).setValues([headers])
    .setFontWeight('bold')
    .setBackground('#03c75a')
    .setFontColor('#ffffff')
    .setHorizontalAlignment('center');

  var summary = getTrendSummary_(keyword, credentials);
  sheet.getRange(2, 1, 1, headers.length).setValues([
    [
      keyword,
      summary.total,
      summary.female,
      summary.male,
      summary.age10,
      summary.age20,
      summary.age30,
      summary.age40,
      summary.age50,
      summary.age60
    ]
  ]);

  sheet.getRange(2, 2, 1, headers.length - 1)
    .setNumberFormat('0.00');

  sheet.autoResizeColumns(1, headers.length);
  sheet.setFrozenRows(1);
}

// 인증 정보 가져오기
function getApiCredentials_() {
  var props = PropertiesService.getScriptProperties();
  var clientId = props.getProperty('CLIENT_ID');
  var clientSecret = props.getProperty('CLIENT_SECRET');

  if (!clientId || !clientSecret) {
    throw new Error('API 인증 정보가 설정되어 있지 않습니다. 먼저 "API 설정" 메뉴에서 정보를 저장해주세요.');
  }

  return {
    clientId: clientId,
    clientSecret: clientSecret
  };
}

// 키워드에 대한 전체/성별/연령대 요약 데이터 조회
function getTrendSummary_(keyword, credentials) {
  var totals = {
    total: fetchTrendAverage_(keyword, credentials, {}),
    female: fetchTrendAverage_(keyword, credentials, { gender: 'f' }),
    male: fetchTrendAverage_(keyword, credentials, { gender: 'm' }),
    age10: fetchTrendAverage_(keyword, credentials, { ages: ['10'] }),
    age20: fetchTrendAverage_(keyword, credentials, { ages: ['20'] }),
    age30: fetchTrendAverage_(keyword, credentials, { ages: ['30'] }),
    age40: fetchTrendAverage_(keyword, credentials, { ages: ['40'] }),
    age50: fetchTrendAverage_(keyword, credentials, { ages: ['50'] }),
    age60: fetchTrendAverage_(keyword, credentials, { ages: ['60'] })
  };

  return totals;
}

// 네이버 데이터랩 검색 트렌드 API 호출 후 평균 ratio 반환
function fetchTrendAverage_(keyword, credentials, options) {
  var now = new Date();
  var timeZone = Session.getScriptTimeZone();
  var payload = {
    startDate: '2016-01-01',
    endDate: Utilities.formatDate(now, timeZone, 'yyyy-MM-dd'),
    timeUnit: 'month',
    keywordGroups: [
      {
        groupName: keyword,
        keywords: [keyword]
      }
    ]
  };

  if (options.gender) {
    payload.gender = options.gender;
  }

  if (options.ages) {
    payload.ages = options.ages;
  }

  var response = UrlFetchApp.fetch('https://openapi.naver.com/v1/datalab/search', {
    method: 'post',
    contentType: 'application/json',
    payload: JSON.stringify(payload),
    headers: {
      'X-Naver-Client-Id': credentials.clientId,
      'X-Naver-Client-Secret': credentials.clientSecret
    },
    muteHttpExceptions: true
  });

  var status = response.getResponseCode();
  if (status !== 200) {
    var errorBody = response.getContentText();
    throw new Error('네이버 데이터랩 API 호출 실패 (HTTP ' + status + ')\n' + errorBody);
  }

  var result = JSON.parse(response.getContentText());
  if (!result.results || !result.results.length || !result.results[0].data) {
    throw new Error('API 응답이 올바르지 않습니다. 응답: ' + response.getContentText());
  }

  var data = result.results[0].data;
  if (!data.length) {
    return 0;
  }

  var totalRatio = data.reduce(function(sum, item) {
    return sum + (item.ratio || 0);
  }, 0);

  var average = totalRatio / data.length;
  return Math.round(average * 100) / 100;
}
